# Xcode build products and per-user state
build/
# The device build's derived data, which was committed by accident: 3,105 files
# and 221MB of module cache, none of it source.
build-device/
DerivedData/
*.xcuserstate
**/xcuserdata/

# Generated by XcodeGen from project.yml
Motionary.xcodeproj/

# macOS metadata
.DS_Store
._*

# Archived designs
.archive/

# Python byte cache, from the analysis scripts importing each other
__pycache__/

# Resources/prebuilt-* and Resources/MFont*.ttf are generated by Studio and are
# committed anyway, which is a deliberate trade. They are the only copy of the
# bundled design - the design store they come from lives in Application Support,
# not here - so a clone without them builds an app that says "No design is built
# into this app yet". Xcode Cloud only ever sees a clone, so committing them is
# what makes a cloud build produce the real app. That is also why one starter is
# bundled rather than three: 153MB rather than 804MB.
